        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "Returning sign-ins",
      "description": "Sign-ins to accounts that already existed. Over the time range picked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(viloq_sign_ins_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\",viloq_sign_in_result=\"signed_in\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null

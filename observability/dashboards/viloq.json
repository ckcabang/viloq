            "uid": "${datasource}"
          },
          "expr": "sum by (viloq_settlement_strategy) (increase(viloq_settlements_suggested_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__range]))",
          "legendFormat": "{{viloq_settlement_strategy}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 17,
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "type": "timeseries",
      "title": "Expenses per group dashboard load",
      "description": "Expenses in a group each time its dashboard loads. The dashboard returns them all, unpaginated: a climbing 99th percentile says when that needs to change.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(viloq_group_expenses_bucket{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])))",
          "legendFormat": "median",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(viloq_group_expenses_bucket{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])))",
          "legendFormat": "95th percentile",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(viloq_group_expenses_bucket{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])))",
          "legendFormat": "99th percentile",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisLabel": "expenses",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "type": "timeseries",
      "title": "Requests failing with a server error",
      "description": "Share of requests answered with a 5xx, per environment and version: what the ViloqServerErrors alert watches (observability/alerts/viloq.yaml). It fires when production stays above the red line, 5% over 5 minutes, for 5 minutes more, with at least 3 failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (deployment_environment_name, service_version) (rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_status_code=~\"5..\"}[$__rate_interval])) or sum by (deployment_environment_name, service_version) (rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])) * 0) / sum by (deployment_environment_name, service_version) (rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} \u00b7 {{service_version}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMax": 0.1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Errors by code",
      "description": "Error responses by the contract's error code, which the status alone runs together: a 409 is version_conflict or currency_locked. Codes with none are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (error_type) (rate(viloq_api_errors_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])) * 60 > 0",
          "legendFormat": "{{error_type}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisLabel": "per minute",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "type": "table",
      "title": "Errors by route",
      "description": "Error responses over the time range picked, most first. A path that matched no route has none.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (http_route, error_type) (increase(viloq_api_errors_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__range])) > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "http_route": 0,
              "error_type": 1,
              "Value": 2
            },
            "renameByName": {
              "http_route": "Route",
              "error_type": "Code",
              "Value": "Errors"
            }
          }
        }
      ]
    }
  ]
}

      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Sign-ins by result",
      "description": "Sign-in links followed, by whether they let someone in. A rise in used_link is the mark of a mail scanner opening links before the person does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (viloq_sign_in_result) (rate(viloq_sign_ins_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])) * 60",
          "legendFormat": "{{viloq_sign_in_result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisLabel": "per minute",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

{
  "uid": "viloq-app",
  "title": "viloq",
  "description": "What people do with viloq, per environment and deployed version. See observability/README.md.",
  "tags": [
    "viloq"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "environment",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(viloq_groups_created_total, deployment_environment_name)",
          "refId": "environment-query",
          "qryType": 1
        },
        "definition": "label_values(viloq_groups_created_total, deployment_environment_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "version",
        "label": "Version",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(viloq_groups_created_total{deployment_environment_name=~\"$environment\"}, service_version)",
          "refId": "version-query",
          "qryType": 1
        },
        "definition": "label_values(viloq_groups_created_total{deployment_environment_name=~\"$environment\"}, service_version)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 2,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "Sign-ups",
      "description": "New accounts: first sign-ins. Over the time range picked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(viloq_sign_ins_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\",viloq_sign_in_result=\"signed_up\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 2,
